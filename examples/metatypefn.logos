# The station #30 north-star, and it runs: a `-> type` function computes a
# type at comptime (resolved inline in the one pass), a declaration takes the
# computed type (`a : metatype(…)` — the dependent declaration), and a comptime
# `if` dispatches on `(dyad a).type` (#52: a value's type is read through
# the view), dropping the untaken branches unparsed — each arm
# parses only in the world where it can run. Every argument works: 0 → i32 place,
# prints 9; 1/2 → f32/f64 place, prints 9.9; 3 → `type`, so `a` is a TYPE
# VARIABLE the last arm fills with i32 at parse, and the program's value is a
# type (prints i32). Currently metatype(2): prints 9.9.

metatype := fn (i:i32) -> type (
    if (i==0) (i32)
    else if (i==1) (f32)
    else if (i==2) (f64)
    else (type)
),
# A type value is a node address, so a -> type function is integers in, an
# integer out: it compiles like any other, and the comptime evaluation of the
# metatype(2) call below jumps to the installed machine code.
metatype.compile(),
b := type,
a:metatype(2),
if ((dyad a).type == i32) (a=9)
else if ((dyad a).type == f32 or (dyad a).type == f64) (a=9.9)
else if ((dyad a).type == type) (a=i32),
a
