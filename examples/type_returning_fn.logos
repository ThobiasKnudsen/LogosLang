# Roadmap #30 Phase 2 — a function can return a type (`-> type`), resolved at
# comptime: the call is run during parsing and becomes the concrete type it
# yields, so it flows as an ordinary type value through `==`, `:=`, and the dyad view.

pick := fn (i := i32 ?) -> type ( if (i == 0) (i32) else (f64) ),

same := pick(0) == i32,   # true:  branch 0 yields i32
other := pick(1) == f64,   # true:  branch 1 yields f64
t := type pick(0),     # t holds i32: `type` keeps the type the call resolved to

print «{same and other and (t == i32)}»
