# Roadmap #30/#52 — types are first-class values.
# A value's type is read through the dyad view — `.` reads only the fields
# a type defines, and a value's type is not one of them, so the view puts the
# type into the value first. Types compare by identity with `==`.

x := i32 5

same  := (dyad x).type == i32        # true: x was built as an i32
cross := (dyad x).type == f64        # false: i32 is not f64
meta  := (dyad i32).type == logos    # true: a type's own type is the `logos` root

same and meta and not (cross)
