# The error value, written in ordinary Logos: an array with one element, a hop, per place the error
# passed. A hop holds its category, the record of the `error.X := «…»` that declared it; its message;
# the node of the graph that raised it; and one value the raise writes, `?` when none
# (›A raise is `error.X «message»`; the error value is an array with one element per hop‹ [[R144]]).
# `error`, with no `.X` after it where a type is wanted, names `hops`.

hop := type (
    category := pub @binding ?,
    message := pub string ?,
    location := pub @dyad ?,
    data := pub dyad ?
),
hops := type array hop,

# The category of the error `alloc` gives where it gets no memory, which the seed hands every program
# (›There is no bare `error «…»`; `abort «…»` stops the program; `alloc` returns `@T!`‹ [[R145]]).
error.out_of_memory := «the allocator refused an alloc»,

# The category of the error a float converted with `lossy` into an integer type gives where it has
# no whole number (›A checked error is a fault: the task that hit it is cancelled‹ [[R141]]).
error.no_whole_number := «a float that is not a number (NaN) or is infinite has no whole number»,

# The error value a raise makes, which the seed calls where the raise runs: one hop, holding the
# category, the message and the node of the raise; no raise writes a value yet.
one_hop := fn (category := @binding ?, message := string ?, location := @dyad ?) -> hops (
    array hop [hop(category, message, location, ?)]
),

# The error value a `try` passes on, which the seed calls where the `try` runs: the hops it was
# handed, then the `try`'s own, which names the category of the hop below it and writes no message
# and no value.
passed := fn (below := hops ?, location := @dyad ?) -> hops (
    count := below.size + 1,
    longer := mut hops ?,
    # `ptr` owns the block and reads it only; `w`, a plain pointer into it, writes it. The block is
    # read out of the `@T!` `alloc` gives: stand-in for #159.
    p := (alloc count of mut hop ?).value,
    w := p + 0,
    longer.ptr = move p,
    for hop_at in 0..below.size (
        (w + hop_at)@ = below[hop_at],
        longer.size = hop_at + 1
    ),
    (w + below.size)@ = hop(below[below.size - 1].category, «», location, ?),
    longer.size = count,
    move longer
)
