# The language defines itself: a power operator `^` written in ordinary Logos,
# used in the same file, and compiled with f.compile().
#
# An operator is a type read in two halves. Its INSTANCE block says what its
# instances hold and do: the operands as named fields, the output the parse
# writes per instance, and the run every instance shares, a bare body over the
# fields. Its BARE lines say how its own spelling parses: where it binds
# (parse_rank), which way it associates, and what happens when `^` stands on
# the tape (parse, a body over the parsing tape `tape`, building the instance
# as `this`, a fresh ^ it fills by name and places with tape[0] = this, then
# marks constructed itself). The run is lexed once here and constructed once
# per set of field types a ^ node is built with, so `^` over i32 and over f64
# is this one definition. A field read such as (a ^ b).lhs walks into the
# instance and runs nothing. The instance block comes first: a body's this.f
# names a field declared above it.

^ := type (
    instance = (
        lhs := ?,
        rhs := i32 ?,
        output := type ?,
        shared run = (
            mut r := this.output 1,
            for 0..this.rhs ( r = r * this.lhs ),
            r
        )
    ),

    parse_rank = *.parse_rank + 1,
    associativity = right,
    parse = (
        this.lhs = tape[-1],
        this.rhs = tape[1],
        this.output = tape[-1]:dyad.type,
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    )
),
f := fn (x := i32 ?) -> i32 ( x ^ 3 + 1 ),
f.compile(),
f(2)
