# The language defines itself: a power operator `^` written in ordinary Logos,
# used in the same file, and compiled with f.compile().
#
# An operator is a type. `^` mints through a function of its own: get_mint builds one type per pair of
# operand types, whose fields `lhs` and `rhs` are typed by them, whose `static output_type`
# is the type its nodes give, and whose run is a bare body over the fields; type_mint
# keeps each mint once built. The parse, a body over the parsing tape `tape`, makes its own
# cell a node of the mint for its operands' types and fills it by name, tape[0].lhs; the
# node it built runs and is never parsed again. A whole exponent is converted to i64 first,
# so x ^ 2 and x ^ n share a mint and x ^ 0.5 has its own. A node's fields are read through
# the graph, b:start.rhs.lhs for b := a ^ c, and that runs nothing.
#
# A whole exponent multiplies, a negative one divides; any other exponent goes
# through exp and ln, in exp.logos and ln.logos. A float on either side, or a fraction as
# the exponent, makes the result a float.

import file «ln.logos»,
import file «exp.logos»,

# The powers no result type holds, each a category of this file.
error.not_whole := «a power of a whole number is not whole»,
error.not_real := «a power is no real number»,
error.needs_float := «a power needs a float result»,

^ := type (
    get_mint := pub static fn (l := type ?, r := type ?) -> type (
        place := type_mint.step(type_mint.step(type_mint.step(0, ^), l), r),
        mint := mut type type_mint.kept(place),
        if mint != ? return mint,
        mint = type (
            lhs := pub l ?,
            rhs := pub r ?,
            output_type := static type if l == f64 or r == f64 (f64)
                else if l == f32 or r == f32 (f32)
                else if r == rational_number (f64)
                else (l),

            # The run is built where `^` is first used, after the program's own names exist,
            # so its locals avoid common ones. NaN and the infinities are no whole exponent,
            # and have no whole number to test.
            run = (
                whole_exponent := if rhs - rhs == 0 (
                    f64 lossy (rhs) == f64 lossy (i64 lossy (rhs))
                ) else (false),
                if (whole_exponent) (
                    power := mut output_type 1,
                    times := mut i64 lossy (rhs),
                    factor := mut if output_type == rational_number (output_type(lhs)) else (output_type lossy (lhs)),
                    if times < 0 (
                        if not (output_type == (f64 or f32 or rational_number))
                            error.not_whole «a negative exponent of a whole number is not whole: write the base as a float»,
                        factor = output_type 1 / factor,
                        times = 0 - times
                    ),
                    for 0..times
                        ( power = power * factor ),
                    power
                ) else if (output_type == (f64 or f32)) (
                    real_base := f64 lossy (lhs),
                    if real_base < 0.0
                        error.not_real «a negative base has no real power for a fractional exponent»,
                    if real_base == 0.0
                        output_type 0
                    else
                        output_type lossy (exp(f64 lossy (rhs) * ln(real_base)))
                ) else
                    error.needs_float «a fractional exponent needs a float result»
            )
        ),
        type_mint.keep(place, mint),
        mint
    ),

    parse_rank = *.parse_rank + 1,
    associativity = right,
    parse = (
        exponent := type if tape[1].type ⊆ i64 (i64) else (tape[1].type),
        tape[0].type = get_mint(tape[-1].type, exponent),
        tape[0].lhs = tape[-1],
        if tape[1].type ⊆ i64 (
            tape[0].rhs = i64 (tape[1])
        ) else (
            tape[0].rhs = tape[1]
        ),
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    )
),

f := fn (x := i32 ?) -> i32 ( x ^ 3 + 1 ),
f.compile(),
print «{f(2)}»
