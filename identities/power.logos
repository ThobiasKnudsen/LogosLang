# The language defines itself: a power operator `^` written in ordinary Logos,
# used in the same file, and compiled with f.compile().
#
# An operator is a type, and its body describes one level: the operands as named
# fields, the type its nodes give back, the run every node shares (a bare body over
# the fields), where `^` binds (parse_rank), which way it associates, and its one
# parse, a body over the parsing tape `tape`. The parse makes its own cell a new ^
# node with tape[0].type = ^ and fills it by name, tape[0].lhs; the node it built
# runs and is never parsed again. The fields' types choose the node's mint, `^`
# over i32 one and over f64 another. A whole exponent is converted to i64 first, so
# x ^ 2 and x ^ n share a mint and x ^ 0.5 has its own. Each mint's output_type, a
# `share` member, is one place per mint, written in its declaration line from the types
# the fields have in that mint. The run names the fields bare. It is lexed once
# here and constructed once per mint, so both mints are this one definition. A
# node's fields are read through the graph, b:start.rhs.lhs for b := a ^ c, and
# that runs nothing.
#
# A whole exponent multiplies, a negative one divides; any other exponent goes
# through exp and ln, in exp.logos and ln.logos. A float on either side, or a fraction as
# the exponent, makes the result a float.

import ln.logos,
import exp.logos,

^ := type (
    lhs := ?,
    rhs := ?,
    share output_type := if lhs.type == f64 or rhs.type == f64 (f64)
        else if lhs.type == f32 or rhs.type == f32 (f32)
        else if rhs.type == rational_number (f64)
        else (lhs.type),

    share parse_rank = *.parse_rank + 1,
    share associativity = right,
    share parse = (
        tape[0].type = ^,
        tape[0].lhs = tape[-1],
        if tape[1].type ⊆ i64 (
            tape[0].rhs = i64 (tape[1])
        ) else (
            tape[0].rhs = tape[1]
        ),
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    ),

    # The run is built after the program's own names exist, so its locals avoid common ones.
    # NaN and the infinities are no whole exponent, and have no whole number to test.
    share run = (
        whole_exponent := if rhs - rhs == 0 (
            f64 lossy (rhs) == f64 lossy (i64 lossy (rhs))
        ) else (false),
        if (whole_exponent) (
            mut power := output_type 1,
            mut times := i64 lossy (rhs),
            mut factor := if output_type == rational_number (output_type(lhs)) else (output_type lossy (lhs)),
            if times < 0 (
                if not (output_type == (f64 or f32 or rational_number))
                    error «a negative exponent of a whole number is not whole: write the base as a float»,
                factor = output_type 1 / factor,
                times = 0 - times
            ),
            for 0..times 
                ( power = power * factor ),
            power
        ) else if (output_type == (f64 or f32)) (
            real_base := f64 lossy (lhs),
            if real_base < 0.0
                error «a negative base has no real power for a fractional exponent»,
            if real_base == 0.0 
                output_type 0
            else 
                output_type lossy (exp(f64 lossy (rhs) * ln(real_base)))
        ) else 
            error «a fractional exponent needs a float result»
    )
),

f := fn (x := i32 ?) -> i32 ( x ^ 3 + 1 ),
f.compile(),
print «{f(2)}»
