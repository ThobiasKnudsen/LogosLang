# The language defines itself: a power operator `^` written in ordinary Logos,
# used in the same file, and compiled with f.compile(). An operator is a type
# with its slots filled: where it binds (parse_rank), which way it associates,
# what a node of it holds (value: the operands as named fields, and the
# output the constructor defines per node), how it parses (constructor, run
# over the parsing tape during the parse, writing the node it builds as
# `this`, short for tape[0]:dyad.value), and what it computes (code, a bare
# body over the node's fields).
#
# Shape ruled 16 and 17 September 2026 (DESIGN ›Execution is function application‹).
# The seed still runs the 4 September shape (tests/fixtures/caret.logos), so
# `logos import ./identities/power.logos` waits on the seed catching up.
^ := type (
    parse_rank = *.parse_rank + 1,       # binds tighter than *
    associativity = right,               # 2 ^ 3 ^ 2 is 2 ^ (3 ^ 2)
    value (
        lhs := ?,                        # the base: takes the type of the operand written into it
        rhs := i32 ?,                    # the exponent: always an i32, a literal molds to it
        output := type ?                 # what a ^ node yields; the constructor defines it
    ),
    constructor = fn (tape := parsing_tape ?) -> void (
        this.lhs = tape[-1],                 # the first write into this builds the ^ node
        this.rhs = tape[1],                  # by name, not by position
        this.output = tape[-1]:dyad.type,    # the result follows the base
        tape.remove(1),                      # both operands consumed:
        tape.remove(-1)                      # only the ^ node remains
    ),
    run = (                              # the power computation over this node's fields
        r := this.output 1,
        for 0..this.rhs ( r = r * this.lhs ),   # no index needed (ruled 17 September 2026)
        r
    )
),
f := fn (x := i32 ?) -> i32 ( x ^ 3 + 1 ),
f.compile(),
f(2)
