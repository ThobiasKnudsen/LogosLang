# The language defines itself: the array collection written in ordinary Logos, in the shape ruled 18 and
# 19 September 2026. array is a chooser: its parse consumes the element type, fetches or mints the concrete
# type `array i32` (one per element type, interned in array_mints) and places it in its own cell with the
# flag left false, so the driver runs the mint's own parse in turn (ruled 19 September 2026).
#
# The mint is a type like any other, read in two halves. Its BARE lines say how its own spelling parses:
# a group to its right becomes an array instance; nothing to its right and it sets its flag and stands as itself,
# the type (`t := array i32`, `a := array i32 ?`; ruled 19 September 2026: "it should rather just be itself in
# constructed state"). Its FIELDS block says what its INSTANCES hold and do, every line marked shared (one
# place for every instance) or left per instance (ruled 19 September 2026): the fields it declares, and the
# predeclared slots it fills, the drop that frees the elements and the instances' own parse trio, which runs
# when an array instance appears on the tape and consumes a [k] to its right, or sets its flag and stands when
# nothing follows (`a = b`). A body in the fields block reached through an instance — a.size_bytes(), the
# instances' parse woken by a's appearance, drop — binds `this` to that instance and reads its fields as
# this.size (ruled 19 September 2026); the fields this. reaches are declared above the body. In the type's own
# parse `this` is the fresh instance being built (18 September 2026). No run: an array used plainly is its own
# value, and a field read such as (a ^ b).lhs never runs anything.
#
# Stand-ins, and the rulings this file leans on:
#   the parse_rank lines (ruled 25 September 2026, DESIGN ›A parse is ranked by what it takes from its right‹):
#     the mint and its instances take a bracket, at application's rank, `dyad.parse_rank`;
#     the chooser takes a type, at `fn.parse_rank`, above application;
#   the slots of a fields block are PREDECLARED (ruled 19 September 2026, DESIGN ›The constructor is a field‹):
#     every fields block starts with the same slots type's own declares (parse_rank, associativity, parse, run,
#     drop, fields), unfilled; a type fills them with `=`, `shared` for one place across its instances, unmarked
#     for a per-instance default; so no line here declares a slot and no right side names a slot type;
#   one `drop` word (ruled 19 September 2026): its parse looks right; `=` there means the slot
#     fill, anything else is the statement dropping what follows, so `drop x` works in every scope and the
#     predeclared slot names are the core words themselves, never a second declaration;
#   `⊆` between types is a seed native (ruled 25 September 2026).
# The seed's array is array-of-@dyad with no spelling and no element access (src/identities/array.rs).
# The fields block comes first in every type body (ruled 20 September 2026): a body's this.f names a field declared above it.

import ./next_power_of_two.logos,

array_mints := hashmap type -> type,

get_mint := fn (t := type ?) -> type (
    mut mint := array_mints[t],
    if mint != ? return mint,
    mint = type (
        fields = (
            shared element_type := t,
            mut ptr := @element_type ?,
            mut size := u64 0,
            mut capacity := u64 0,
            shared size_bytes := fn () -> u64 (this.size * this.element_type.size_bytes),
            shared capacity_bytes := fn () -> u64 (this.capacity * this.element_type.size_bytes),

            shared drop = (
                for i in 0..this.size ( drop (this.ptr + i)@ ),
                free this.ptr
            ),

            shared parse_rank = dyad.parse_rank,
            shared associativity = left,
            shared parse = (
                if tape[1]:type == square_brackets (
                    index := tape[1].dyads[0],
                    if not index:type ⊆ this.size:type
                        error «the index type is not within the size type, so the index could lie outside the array»,
                    tape[0] = scope (
                        if index >= this.size error «index out of range: the index is at or past the array's size»,
                        (this.ptr + index)@
                    ),
                    tape.remove(1)
                ),
                tape.is_constructed[0] = true
            )
        ),

        parse_rank = dyad.parse_rank,
        associativity = left,
        parse = (
            if tape[1]:type == scope (
                this.size = tape[1].dyads.size,
                this.capacity = next_power_of_two(this.size),
                this.ptr = alloc this.capacity of this.element_type ?,
                for i in 0..this.size ( (this.ptr + i)@ = tape[1].dyads[i] ),
                tape[0] = this,
                tape.remove(1)
            ),
            tape.is_constructed[0] = true
        )
    ),
    array_mints[t] = mint,
    mint
),

pub array := type (
    parse_rank = fn.parse_rank,
    associativity = right,
    parse = (
        if tape[1]:type != type
            error «id after array is not a type»,
        t := tape[1],
        tape[0] = get_mint(t),
        tape.remove(1)
    )
)
