# The language defines itself: the array collection written in ordinary Logos, in the shape
# power.logos has (DESIGN ›Execution is function application‹ and ›The constructor is a field‹,
# 16 to 18 September 2026). An array carries two constructors, and both are licensed:
#   parse = (…) in the body's bare lines fills array's OWN parse slot, the per-instance slot that
#   `word` declares so that every type supplies its own. It runs when the spelling `array` appears,
#   `array i32 (1, 2, 3)`, builds the node as `this`, and places it with tape[0] = this.
#   parse := parse (…) inside value = (…) is the constructor of array's INSTANCES. A member of the
#   value block whose value is defined and never mut is stored once (the Two-muts rule; the word
#   `shared` is retired), so one behaviour serves every array node: it runs when a node appears,
#   `a[2]`, consumes the `[…]` to its right, and emits the bounds check as residual code (DESIGN:
#   "the collection's instance constructor consumes that constructed node").
# Open, not ruled, spelled here as stand-ins:
#   the instance slot is named after its type, and `:=` declares its name before it reads its
#     value, so the right-hand `parse` would meet the new field (the `x := f(own x)` rule of
#     3 September 2026); word.logos has the same shape in `parse := parse ?`;
#   what `this` binds to in an instance constructor: the 18 September amendment says a fresh node
#     of the type being defined, which an element access has no use for; the node that appeared
#     is tape[0], and `this` goes unused below;
#   `array i32` alone as an interned type and `a := array i32 ?` as a declaration (DESIGN
#     ›Representation‹, the generic chooser): this constructor still demands the element group;
#   `[`'s own layout (`[ := ?` in the sketch): the field `index` is assumed;
#   the parse_rank number, and the missing drop slot (data is alloc'd and never freed; #130).
# The seed's array is array-of-@dyad with no spelling and no element access (src/identities/array.rs).
array := word (
    parse_rank = …,                          # above the juxtaposition level, so array takes i32 before i32 could take the group as a conversion (ruled 2 September 2026); word supplies no default
    associativity = right,                   # a prefix reader: among equals the rightmost runs first, so a nested array builds inside out
    value = (
        element_type := word ?,              # the type every element has
        size := u64 ?,                       # a hole is a place per node; `u64 0` would be stored once under the Two-muts rule
        capacity := u64 ?,
        data := @void ?,
        parse := parse (                     # the instances' constructor, stored once: runs when an array node appears
            if tape[1]:dyad.type == lex «[»[0]:dyad (        # a [ … ] to the right, constructed at discovery as ( is
                index := tape[1]:dyad.value.index,
                arr := tape[0],
                if not index:dyad.type ⊆ arr:dyad.value.size:dyad.type
                    error «type of index in square_brackets is not a subset of or equal to the type of the size of the array instance, meaning the index could be out of range in the array»,
                # index and size are not known statically: the access is residual code, a scope that runs when they are
                tape[0] = scope (
                    if index >= arr:dyad.value.size error «index out of range: the index is at or past the array's size»,
                    (@arr:dyad.value.element_type (arr:dyad.value.data) + index)@      # the last @ dereferences
                ),
                tape.remove(1)               # the [ … ] is consumed; the access scope stands where the array node stood
            )                                # no [ to the right: nothing to consume, the constructor declines, the frontier untouched
        )
    ),
    parse = (                                # array's own constructor: `array i32 (1, 2, 3)`
        if tape[1]:dyad.type != word error «id after array is not a type»,
        if tape[2]:dyad.type != scope error «second id after array does not have the type scope»,
        # (check that every element of the scope converts to the element type)
        this.element_type = tape[1],         # this: a fresh array node, its value fields holes (ruled 18 September 2026)
        this.size = tape[2]:dyad.value.size, # the scope's value is the array of its expressions
        this.capacity = (2^n where n := u8 ? and 2^(n-1) < this.size <= 2^n),   # the least power of two at or above size, in the older sketch's words
        this.data = alloc (this.element_type.size_bytes * this.capacity),
        for i in 0..this.size ( (@this.element_type (this.data) + i)@ = tape[2]:dyad.value[i] ),
        tape[0] = this,                      # the constructor places the node it built
        tape.remove(1),                      # the type and the group are consumed:
        tape.remove(1)                       # only the array node remains
    )
)
