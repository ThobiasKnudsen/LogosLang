# The language defines itself: the array collection written in ordinary Logos, in the shape
# power.logos has (DESIGN ›Execution is function application‹ and ›The constructor is a field‹,
# 16 to 18 September 2026). array is a chooser (DESIGN ›Representation‹: "a generic type is a
# chooser like a generic fn, each parameter yielding its own concrete identity built once"), so
# it has no value block of its own. Its parse reads the element type, fetches the concrete word
# `array i32` from array_mints or mints it once, places it, and runs it over what follows. The
# minted word is where an array lives: its own parse builds a node from the element group as
# `this`, its value block holds what every array node carries, and the constructor inside that
# value block is the constructor of array's INSTANCES, stored once because a value-block member
# whose value is defined and never mut is stored once (the Two-muts rule; the word `shared` is
# retired): it runs when an array node appears, `a[2]`, consumes the `[…]` to its right, and
# emits the bounds check as residual code ("the collection's instance constructor consumes that
# constructed node"). `a:dyad.type == array i32` is the check, exact because the mint is interned
# (ruled 18 September 2026: enough for always). `a := array i32 ?` is the hole's business: `?`
# reads the type standing to its left, so the mint declines and the hole declares.
# Open, not ruled, spelled here as stand-ins:
#   the instance slot is named after its type, and `:=` declares its name before it reads its
#     value, so the right-hand `parse` would meet the new field (the `x := f(own x)` rule of
#     3 September 2026); word.logos has the same shape in `parse := parse ?`;
#   what `this` binds to in an instance constructor: the 18 September amendment says a fresh node
#     of the type being defined, which an element access has no use for; the node that appeared
#     is tape[0], and `this` goes unused there;
#   `[`'s own layout (`[ := ?` in the sketch): the field `index` is assumed;
#   the two parse_rank numbers, and the missing drop slot (data is alloc'd and never freed; #130).
# The seed's array is array-of-@dyad with no spelling and no element access (src/identities/array.rs).
array := word (
    parse_rank = …,                          # above the juxtaposition level, so array takes i32 before i32 could take the group as a conversion (ruled 2 September 2026); word supplies no default
    associativity = right,                   # a prefix reader: among equals the rightmost runs first, so a nested array builds inside out
    mint := fn (t := word ?) -> word (       # what an array of t is: the concrete word `array t`, built once per t by the parse below
        word (
            element_type := t,               # one place on the mint: read a:dyad.type.element_type outside, bare inside the bodies below
            parse_rank = …,                  # the call defaults: the mint reads its right as a call does
            associativity = left,
            value = (                        # what every array node holds
                size := u64 ?,               # a hole is a place per node; `u64 0` would be stored once under the Two-muts rule
                capacity := u64 ?,
                data := @void ?,
                parse := parse (             # the instances' constructor, stored once: runs when an array node appears
                    if tape[1]:dyad.type == lex «[»[0]:dyad (        # a [ … ] to the right, constructed at discovery as ( is
                        index := tape[1]:dyad.value.index,
                        arr := tape[0],
                        if not index:dyad.type ⊆ arr:dyad.value.size:dyad.type
                            error «type of index in square_brackets is not a subset of or equal to the type of the size of the array instance, meaning the index could be out of range in the array»,
                        # index and size are not known statically: the access is residual code, a scope that runs when they are
                        tape[0] = scope (
                            if index >= arr:dyad.value.size error «index out of range: the index is at or past the array's size»,
                            (@element_type (arr:dyad.value.data) + index)@      # the last @ dereferences
                        ),
                        tape.remove(1)       # the [ … ] is consumed; the access scope stands where the array node stood
                    )                        # no [ to the right: nothing to consume, the constructor declines, the frontier untouched
                )
            ),
            parse = (                        # the mint's own constructor: `array i32 (1, 2, 3)`
                if tape[1]:dyad.type == scope (
                    # (check that every element of the scope converts to the element type)
                    this.size = tape[1]:dyad.value.size,         # this: a fresh array node, its value fields holes (ruled 18 September 2026); the scope's value is the array of its expressions
                    this.capacity = (2^n where n := u8 ? and 2^(n-1) < this.size <= 2^n),   # the least power of two at or above size, in the older sketch's words
                    this.data = alloc (element_type.size_bytes * this.capacity),
                    for i in 0..this.size ( (@element_type (this.data) + i)@ = tape[1]:dyad.value[i] ),
                    tape[0] = this,          # the constructor places the node it built
                    tape.remove(1)           # the group is consumed: only the array node remains
                )                            # no group to the right: the mint stands as the type itself, `t := array i32`, or a ? takes it
            )
        )
    ),
    parse = (                                # the chooser: `array i32` is one word, minted once
        if tape[1]:dyad.type != word error «id after array is not a type»,
        t := tape[1]:dyad,                   # the element type itself, the dyad the name is bound to
        found := array_mints.find(t),
        if found != ? ( tape[0] = found ) else (
            fresh := mint(t),
            array_mints.add(fresh),
            tape[0] = fresh
        ),
        tape.remove(1),                      # the element type is consumed
        tape[0].parse(tape)                  # the mint is anonymous and nothing wakes it: run it here over what follows, a group or nothing
    )
)
