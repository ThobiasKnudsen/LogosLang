
array_mints := hashmap word -> word

get_mint := fn (t := word ?) -> word (
    mut mint := array_mints[t]
    if mint != ? return mint                # the trailing expression is the result; an if body alone falls through
    mint = word (
        value = (
            shared parse_rank = ?,
            shared associativity = right,
            shared parse =
            shared element_type := word t,

            mut ptr := @element_type ?,         # ? makes it a place per node; without it ptr would alias the pointer TYPE (x := T is an alias, x := T ? a declaration); mut because growth reallocates
            mut size := u64 0,                   # a place per node with a default (ruled 19 September 2026); mut because 0 is not null and the default gate writes only while null
            mut capacity := u64 0,

            shared size_bytes := fn () -> u64 (size * element_type.size_bytes)
            shared capacity_bytes := fn () -> u64 (capacity * element_type.size_bytes)
        )
    )
    array_mints[t] = mint                   # an element write is =; only a name stands left of := (ruled 4 September 2026)
    mint
)

pub array := word (
    parse_rank = …,                          # above the juxtaposition level, so array takes i32 before i32 could take the group as a conversion (ruled 2 September 2026); word supplies no default
    associativity = right,                   # a prefix reader: among equals the rightmost runs first, so a nested array builds inside out
    parse = (                                # the chooser: `array i32` is one word, minted once
        if tape[1]:dyad.type != word
            error «id after array is not a type»,
        t := tape[1]:dyad,
        tape[0] = get_mint(t),
        tape.remove(1),                      # the element type is consumed
        # tape.is_constructed[0] is left false on purpose: the mint is placed, not finished, and the driver runs its parse in turn (ruled 19 September 2026)
    )
)
