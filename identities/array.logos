# The array collection, written in ordinary Logos. `array` is a chooser: it takes the element type and
# leaves on the tape the concrete type for it, `array i32`, minted once per element type, whose own parse
# then runs. A mint's bare lines say how its spelling parses; its fields block says what its instances
# hold and do (DESIGN ›The constructor is a field‹).

import ./next_power_of_two.logos,

get_mint := fn (t := type ?) -> type (
    shared array_mints := hashmap type -> type,
    mut mint := array_mints[t],
    if mint != ? return mint,
    mint = type (
        fields = (
            shared element_type := t,
            mut ptr := @element_type ?,
            mut size := u64 0,
            mut capacity := u64 0,
            shared size_bytes := fn () -> u64 (this.size * this.element_type.size_bytes),
            shared capacity_bytes := fn () -> u64 (this.capacity * this.element_type.size_bytes),

            shared drop = (
                for i in 0..this.size ( drop (this.ptr + i)@ ),
                free this.ptr
            ),

            shared parse_rank = dyad.parse_rank,
            shared associativity = left,
            shared at := fn (index := u64 ?) -> element_type (
                if index >= this.size error «index out of range: the index is at or past the array's size»,
                (this.ptr + index)@
            ),

            shared fill := fn (elements) -> this:type (
                this.size = elements.dyads.size,
                this.capacity = next_power_of_two(this.size),
                this.ptr = alloc this.capacity of this.element_type ?,
                for i in 0..this.size (
                    if not (elements.dyads[i]:type ⊆ this.element_type)
                        error «an element does not fit the element type»,
                    (this.ptr + i)@ = elements.dyads[i]
                ),
                this
            ),

            shared parse = (
                if tape[1]:type == square_brackets (
                    if not tape[1].dyads[0]:type ⊆ this.size:type
                        error «the index type is not within the size type, so the index could lie outside the array»,
                    tape[0] = this.at(tape[1].dyads[0]),
                    tape.remove(1)
                ),
                tape.is_constructed[0] = true
            )
        ),

        # The mint takes a bracket at application's rank (DESIGN ›A parse is ranked by what it takes from its right‹).
        parse_rank = dyad.parse_rank,
        associativity = left,
        parse = (
            if tape[1]:type == scope or tape[1]:type == square_brackets (
                for i in 0..tape[1].dyads.size (
                    if not (tape[1].dyads[i]:type ⊆ this.element_type)
                        error «an element does not fit the element type»
                ),
                tape[0] = this.fill(tape[1]),
                tape.remove(1)
            ),
            tape.is_constructed[0] = true
        )
    ),
    array_mints[t] = mint,
    mint
),

pub array := type (
    # Above application, so the chooser takes its type before the mint takes the bracket.
    parse_rank = fn.parse_rank,
    associativity = right,
    parse = (
        if tape[1]:type != type
            error «id after array is not a type»,
        t := tape[1],
        tape[0] = get_mint(t),
        tape.remove(1)
    )
)
