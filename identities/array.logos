# The array collection, written in ordinary Logos. `array` takes the element type and leaves the type
# of its values, `array i32`, minted once per element type, whose parse reads an index. Before a `[…]`
# it builds an `array` node instead, whose run makes a new value of that type each time it is evaluated
# (DESIGN ›An array expression is a node of `array`, and its run makes the value‹).

# The kinds of mistake an array refuses, each a category of this file.
error.index_out_of_range := «an index lies outside its array»,
error.index_type := «an index is of a type that could lie outside its array»,
error.not_a_type := «what stands after `array` is no type»,
error.not_a_list := «an array's list is not written in square brackets»,
error.element_type := «an element does not fit its array's element type»,

pub array := type (
    static array_mints := hashmap type -> type,
    pub static get_mint := fn (t := type ?) -> type (
        mut mint := type array_mints[t],
        if mint != ? return mint,
        mint = type (
            pub static element_type := type t,
            pub mut ptr := own @element_type ?,
            pub mut size := u64 0,
            pub static size_bytes := fn () -> u64 (size * element_type.size_bytes),

            static free = (
                for i in 0..size ( free (ptr + i)@ ),
                free ptr
            ),

            pub static at := fn (index := u64 ?) -> element_type (
                if index >= size error.index_out_of_range «the index is at or past the array's size»,
                (ptr + index)@
            ),
            static at_signed := fn (index := i64 ?) -> element_type (
                if index < 0 or u64 lossy (index) >= size
                    error.index_out_of_range «the index is negative or at or past the array's size»,
                (ptr + index)@
            ),

            # Takes a bracket at application's rank (DESIGN ›A parse is ranked by what it takes from its right‹).
            static parse_rank = dyad.parse_rank,
            static associativity = left,
            static parse = (
                if tape[0].type != type and tape[1].type == square_brackets (
                    # A signed index goes to `at_signed`, whose bounds check refuses a negative value.
                    if tape[1].dyads[0].type ⊆ tape[0].size.type (
                        tape[0] = tape[0].at(tape[1].dyads[0])
                    ) else (
                        # A literal's value is known now, so one outside the size type is refused now.
                        if tape[1].dyads[0].type == rational_number
                            error.index_type «the index type is not within the size type, so the index could lie outside the array»,
                        if not tape[1].dyads[0].type ⊆ i64
                            error.index_type «the index is not an integer»,
                        tape[0] = tape[0].at_signed(tape[1].dyads[0])
                    ),
                    tape.remove(1)
                ),
                tape.is_constructed[0] = true
            )
        ),
        array_mints[t] = mint,
        mint
    ),

    # The parse asks through a call, so the branch it guards is built where it is written: stand-in for #455.
    static bytes_of := fn (t := type ?) -> u64 ( t.size_bytes ),

    elements := square_brackets ?,
    output_type := type ?,

    static run = (
        mut v := output_type ?,
        v.ptr = mut alloc elements.dyads.size of v.element_type ?,
        # size counts only written elements, so a failed `=` leaves free nothing unwritten to walk.
        for i in 0..elements.dyads.size (
            (v.ptr + i)@ = elements.dyads[i],
            v.size = i + 1
        ),
        move v
    ),

    # Above application, so it takes its element type before anything else reads it.
    static parse_rank = fn.parse_rank,
    static associativity = right,
    static parse = (
        # Nothing to its right (`tape[1]` is `void`), or a type with no instance bytes, as `void` and an
        # operation such as `==` are: no branch builds, so `array` touches nothing and stands as its own
        # value (›`array` is a chooser‹ [[R223]]).
        if tape[1] == ? (
            tape.is_constructed[0] = true
        ) else if tape[1].type != void (
            if tape[1].type != type
                error.not_a_type «id after array is not a type»,
            t := type tape[1],
            if bytes_of(t) != 0 (
                mint := type get_mint(t),
                if tape[2].type == scope
                    error.not_a_list «the list is written in square brackets, `array i32 [1, 2]`, not `array i32 (1, 2)`»,
                # Right of another `array` this one is the element type, and the list is the outer one's.
                if tape[2].type == square_brackets and tape[-1] != array (
                    # A bracket line is checked when the run's `=` builds it.
                    for i in 0..tape[2].dyads.size (
                        if tape[2].dyads[i].type != square_brackets and tape[2].dyads[i].type != scope (
                            if not (tape[2].dyads[i].type ⊆ t)
                                error.element_type «an element does not fit the element type»
                        )
                    ),
                    tape[0].type = array,
                    tape[0].elements = tape[2],
                    tape[0].output_type = mint,
                    tape.is_constructed[0] = true,
                    tape.remove(2),
                    tape.remove(1)
                ) else (
                    tape[0] = mint,
                    tape.remove(1)
                )
            )
        )
    )
)
