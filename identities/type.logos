type := type (
    # what every type carries: declared here, a slot per type, filled by each type's own body with =
    instance (
        precedence := f64 ?
        associativity := ?          # left or right
        constructor := fn (tape := parsing_tape ?) -> void ?
        destructor := ?
    )

    # what type itself is: the same slots, filled
    precedence = f64 2.0
    associativity = left
    constructor = fn (tape := parsing_tape ?) -> void (

        if tape[1].type != scope
            error «tape[1].type is not scope»
        if not tape[1].is_constructed
            error «tape[1] is scope and not constructed. It should be»

        # assuming scope is somehow constructed.
        # I dont know exactly how it may automatically be constructed here yet

    )
)
