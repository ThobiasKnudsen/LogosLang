fn := type (
    constructor = fn (tape := parsing_tape ?) -> void ( ? )
    instance (
        compile := fn () -> void ( ? )       # stored once, read on instances: read own body, lower it to bcode
        run     := fn () -> void ( ? )       # if bcode present jump to it; if bcode is NULL walk body directly. interpretation is run's null-bcode path, not a separate function
        input := type ?
        output := ?
        body := ?                            # the reflectable LG body
        bcode := callable ?                  # the complete jump info [entry @exec, convention] (NULL until compiled)
        frame := u64 ?                       # the activation-record byte size (per-call locals), NULL when none
    )
)
