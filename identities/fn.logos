
fn := type (
    input := type ?
    output_type := type ?
    bcode := callable ?
    frame := u64 ?
    compile := pub static fn () -> void ( ? )

    parse_rank = …
    associativity = left
    # Takes `(params)`, `->` and the body; the function it builds runs, and is never parsed again.
    parse = ( ? )
)
