
fn := type (
    input := type ?
    output := ?
    bcode := callable ?
    frame := u64 ?
    shared compile := fn () -> void ( ? )

    parse_rank = …
    associativity = left
    parse = (
        # `fn` itself builds a function from `(params) -> T (body)`; a function takes its arguments.
        if tape[0]:type == type ( ? ) else ( ? )
    )
)
