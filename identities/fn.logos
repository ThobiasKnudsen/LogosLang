
fn := type (
    input := type ?
    output_type := type ?
    bcode := callable ?
    frame := u64 ?
    static compile := fn () -> void ( ? )

    static parse_rank = …
    static associativity = left
    # Takes `(params)`, `->` and the body; the function it builds runs, and is never parsed again.
    static parse = ( ? )
)
