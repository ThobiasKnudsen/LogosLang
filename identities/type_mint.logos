# The one keeper of every mint, written in ordinary Logos. A mint's key is its former and the
# addresses of its arguments, each already minted, so equal contents have equal addresses. The key
# is walked as a trie of hashmaps: `step` goes one level down, from the place `at` by one argument,
# and the walk starts at place 0 with the former as its first argument. A name in the key, as a
# field's, is walked by its spelling, with `step_name`, and a whole number, as a rank or a value a
# `static` holds, with `step_word`. `kept` gives the mint kept at a place, or `?`, and `keep` keeps
# one there, once: a place that holds a mint refuses another. The former builds its own mint where
# none is kept
# (›Every type is minted by its contents through `type_mint`; the name that holds a `type ( … )`
# gives it its identity‹ [[R383]]).

# The kind of mistake the keeper refuses, a category of this file.
error.already_kept := «a mint is kept at a place that already holds one»,

type_mint := pub type (
    # A place's branch, by argument; the place one level down is the one entry of the map found.
    branches := static hashmap u64 -> hashmap type -> hashmap u64 -> u64,
    name_branches := static hashmap u64 -> hashmap string -> hashmap u64 -> u64,
    word_branches := static hashmap u64 -> hashmap u64 -> hashmap u64 -> u64,
    mints := static hashmap u64 -> type,
    places := static mut u64 0,

    step := pub static fn (at := u64 ?, argument := type ?) -> u64 (
        branch := mut branches[at],
        if branch == ? ( branch = hashmap type -> hashmap u64 -> u64 ),
        next := mut branch[argument],
        if next == ? (
            places = places + 1,
            next = hashmap u64 -> u64,
            next[0] = places,
            branch[argument] = next,
            branches[at] = branch
        ),
        next[0]
    ),

    step_name := pub static fn (at := u64 ?, name := string ?) -> u64 (
        branch := mut name_branches[at],
        if branch == ? ( branch = hashmap string -> hashmap u64 -> u64 ),
        next := mut branch[name],
        if next == ? (
            places = places + 1,
            next = hashmap u64 -> u64,
            next[0] = places,
            branch[name] = next,
            name_branches[at] = branch
        ),
        next[0]
    ),

    step_word := pub static fn (at := u64 ?, word := u64 ?) -> u64 (
        branch := mut word_branches[at],
        if branch == ? ( branch = hashmap u64 -> hashmap u64 -> u64 ),
        next := mut branch[word],
        if next == ? (
            places = places + 1,
            next = hashmap u64 -> u64,
            next[0] = places,
            branch[word] = next,
            word_branches[at] = branch
        ),
        next[0]
    ),

    kept := pub static fn (at := u64 ?) -> type ( mints[at] ),
    keep := pub static fn (at := u64 ?, made := type ?) -> void (
        if mints[at] != ? error.already_kept «a key's mint is made once»,
        mints[at] = made
    )
)
