# The one keeper of every mint, written in ordinary Logos. A mint's key is its former and the
# addresses of its arguments, each already minted, so equal contents have equal addresses. The key
# is walked as a trie of hashmaps: `step` goes one level down, from the place `at` by one argument,
# and the walk starts at place 0 with the former as its first argument. `kept` gives the mint kept
# at a place, or `?`, and `keep` keeps one there. The former builds its own mint where none is kept
# (›Every type is minted by its contents through `type_mint`; the name that holds a `type ( … )`
# gives it its identity‹ [[R383]]).

pub type_mint := type (
    # A place's branch, by argument; the place one level down is the one entry of the map found.
    static branches := hashmap u64 -> hashmap type -> hashmap u64 -> u64,
    static mints := hashmap u64 -> type,
    static mut places := u64 0,

    pub static step := fn (at := u64 ?, argument := type ?) -> u64 (
        mut branch := branches[at],
        if branch == ? ( branch = hashmap type -> hashmap u64 -> u64 ),
        mut next := branch[argument],
        if next == ? (
            places = places + 1,
            place := u64 places,
            next = hashmap u64 -> u64,
            next[0] = place,
            branch[argument] = next,
            branches[at] = branch
        ),
        next[0]
    ),

    pub static kept := fn (at := u64 ?) -> type ( mints[at] ),
    pub static keep := fn (at := u64 ?, made := type ?) -> void ( mints[at] = made )
)
