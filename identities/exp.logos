# The exponential function, written in Logos.

# exp(k ln 2 + r) = 2^k exp(r), with |r| < ln 2 so the series is short. Below -746 the
# nearest f64 to exp(y) is 0 and above 710 it is inf, so k is computed only between, where
# it fits an i64; exp(NaN) is NaN.
pub exp := fn (y := f64 ?) -> f64 (
    if y > -746.0 and y < 710.0 (
        ln2 := f64 lossy 0.6931471805599453,
        k := i64 lossy (y / ln2),
        r := y - f64 lossy (k) * ln2,
        mut term := f64 1.0,
        mut sum := f64 1.0,
        mut n := f64 1.0,
        while n < 30.0 (
            term = term * r / n,
            sum = sum + term,
            n = n + 1.0
        ),
        mut i := i64 0,
        if k >= 0 (
            while i < k
                ( sum = sum * 2.0, i = i + 1 )
        ) else (
            while i > k
                ( sum = sum / 2.0, i = i - 1 )
        ),
        sum
    ) else if y < 0.0 (
        f64 0.0
    ) else if y > 0.0 (
        f64 1.0 / 0.0
    ) else (
        y
    )
)
