# The exponential function, written in Logos.

# exp(k ln 2 + r) = 2^k exp(r), with |r| < ln 2 so the series is short.
pub exp := fn (y := f64 ?) -> f64 (
    k := i64(y / 0.6931471805599453),
    r := y - f64(k) * 0.6931471805599453,
    mut term := f64 1.0,
    mut sum := f64 1.0,
    mut n := f64 1.0,
    while n < 30.0 ( 
        term = term * r / n, 
        sum = sum + term, 
        n = n + 1.0 
    ),
    mut i := i64 0,
    if k >= 0 ( 
        while i < k 
            ( sum = sum * 2.0, i = i + 1 ) 
    ) else ( 
        while i > k 
            ( sum = sum / 2.0, i = i - 1 ) 
    ),
    sum
)
