# The exponential function, written in Logos.

# exp(k ln 2 + r) = 2^k exp(r), with |r| < ln 2 so the series is short. NaN and the
# infinities have no whole k: exp(NaN) is NaN, exp(inf) is inf and exp(-inf) is 0.
pub exp := fn (y := f64 ?) -> f64 (
    if y - y == 0.0 (
        ln2 := f64 lossy 0.6931471805599453,
        k := i64 lossy (y / ln2),
        r := y - f64 lossy (k) * ln2,
        mut term := f64 1.0,
        mut sum := f64 1.0,
        mut n := f64 1.0,
        while n < 30.0 (
            term = term * r / n,
            sum = sum + term,
            n = n + 1.0
        ),
        mut i := i64 0,
        if k >= 0 (
            while i < k
                ( sum = sum * 2.0, i = i + 1 )
        ) else (
            while i > k
                ( sum = sum / 2.0, i = i - 1 )
        ),
        sum
    ) else if y < 0.0 (
        f64 0.0
    ) else (
        y
    )
)
