# ( is the scope opener and the driver (DESIGN ›The scope's constructor is the driver‹, eager-segment model,
# ruled 30 August 2026; respelled to it 5 September 2026). constructed at discovery, it lexes its interior one
# cell at a time: a cell whose identity's precedence is at or above ('s own is constructed the moment it is lexed
# — #, «, import, an inner (, and the identities that read their own bracket: fn, for, while, defer, type, a
# language, an instance — and every other cell waits. at a segment boundary — a , or the closing ) — the cells
# lexed since the previous boundary are constructed highest precedence first, associativity breaking ties, each
# constructor taking what it needs from the fully lexed segment, left or right, any arity, with no lookahead; a
# cell still unconstructed afterwards is the checked error. the constructed cells, in order, are the scope's
# expressions, the array the scope dyad's value references. no holding, no re-invocation.
( := type (
    precedence = …                       # near the top of the axis; , sits above it
    associativity = left
    constructor = fn (tape := parsing_tape ?) -> void (
        body := array @dyad ()
        first := 1                       # the first cell of the current segment
        i := 1
        while true (
            cell := tape[i]              # lexes the next token on demand
            if cell == lex «)»[0] or cell == lex «,»[0] (
                # segment boundary: construct what was lexed since the previous one, highest precedence first
                while true (
                    k := highest_unconstructed(tape, first, i)      # ties broken by associativity; ? when none is left
                    if k == ? break
                    tape[k].constructor(tape.recenter(k))           # the constructor edits the tape in place
                )
                for k in first..i (
                    if not tape.is_constructed[k]                   # flag-read spelling open, see parsing_tape
                        error «unconstructed cell at a segment boundary»
                    body.push(tape[k])
                )
                if cell == lex «)»[0] break
                first = i + 1
            ) else if cell.precedence >= (.precedence (
                cell.constructor(tape.recenter(i))                  # constructed at discovery, before the next token lexes
            )
            i = i + 1
        )
        tape[0] = dyad (scope, body)     # replace the opener's own cell with the finished scope
        for k in 1..i+1 ( tape.remove(1) )   # the interior and the closer are consumed
    )
)
