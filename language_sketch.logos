logos := logos (
    # the one classifier: the former type/struct/language, merged (ruled July 2026).
    # the language IS the root logos — declaring into the language is declaring into
    # this identity's scope, and every classification chain terminates here (logos : logos).
    shared precedence := f64 2.0
    shared associativity := u8 left_to_right
    shared constructor := fn (tape : parsing_tape) -> void! (
        if tape[0].logos != token
            error «offset 0 is not a token»
        if tape[0].hyle != logos
            error «token does not denote logos»
        # one constructor, three outcomes: stand as the bare classifier value; consume a
        # following logos into a value by juxtaposition (logos i32); or build a record
        # logos from a following body scope (the former struct path) — TBD
    )
    shared destructor := ? ?
    # the record case derives fields and size_bytes from the field declarations in the
    # body scope. field NAMES are not stored here: they enter the shared name index (the
    # regex trie of id_contexts) like every declaration and resolve by open-scope
    # filtering. a per-record names hashtable was rejected.
    fields : array synolon
    size_bytes : u64
)

declare := fn (lang:&mut logos, name:string) -> &mut synolon ( ? )
assign := fn (node:&mut synolon, logos:@synolon, hyle:@void) -> void! ( ? )
assign(declare(&mut logos, «:»), ?, ?)
assign(declare(&mut logos, «=»), ?, ?)
assign(declare(&mut logos, «:=»), ?, ?)
assign(declare(&mut logos, «rational_number»), logos, ?)
assign(declare(&mut logos, «[0-9]+(?:\.[0-9]+)?»), rational_number, ?)   # unanchored: the lexer longest-matches a prefix of the remaining input, so no ^…$. unsigned: - is always the operator (a-1 must be subtraction); a negative literal is the prefix - folding at parse

synolon := logos (logos := @synolon ?, hyle := @void ?)

id_context := logos (
    identity := @synolon ?   # the declared identity this spelling denotes
    scope    := @synolon ?   # the enclosing scope it was declared in; O(1) open-scope membership picks the live one
)

token := logos (
    text := string ?         # the matched source span; resolved against the name index to the one id_context live in the open scopes at reduction
)

parsing_tape := logos (
    # the working frontier: reduced-but-not-final synolons interleaved with pending tokens (lexed-in-flight
    # and lazily lexed-ahead). tape[0] is the token of the identity being constructed; negative offsets
    # reach left into reduced context, positive offsets lazily lex ahead. disposable, rebuilt from source.
    shared insert := ? ?     # splice tokens/synolons into the frontier (the macro / custom-syntax mechanism)
    shared remove := ? ?     # remove from the frontier
)

array := logos (
    shared constructor = fn (tape : parsing_tape) -> void! (
        if tape[0].logos != token
            error «offset 0 is not a token»
        if tape[0].hyle != array
            error «token does not denote array»
        if tape[1].hyle@.logos != logos
            error «token after array is not a logos»
        # specialize this array logos to the element logos at offset 1 — TBD
    )
    element := logos ?
    size := u64 0
    capacity := u64 0
    content := @void ?
)

mut := logos (
    shared constructor = fn (tape : parsing_tape) -> void! (
        if tape[0].logos != token
            error «offset 0 is not a token»
        if tape[0].hyle != mut
            error «token does not denote mut»
        if tape[1].hyle@.logos != logos
            error «token after mut is not a logos»
        # set the mutability bit on this level's hyle pointer — TBD
    )
)

fn := logos (
    shared constructor = fn (tape : parsing_tape) -> void! ( ? )
    shared compile     = fn () -> void! ( ? )       # read own body, lower it to bcode
    shared run         = fn () -> void! ( ? )       # if bcode present jump to it; if bcode is NULL walk body directly. interpretation is run's null-bcode path, not a separate function
    input  : logos
    output : ?
    body   : ?                                       # the reflectable LG body
    bcode  : callable                                # the complete jump info [entry @exec, convention] (NULL until compiled)
    frame  : u64                                     # the activation-record byte size (per-call locals), NULL when none
)

@ : ?
-> : ?

\\ : ?
\« : ?
\» : ?
\# : ?   # the one comment constructor: takes a «…» string or raw text to end of line; builds a reflectable, void-valued comment node

\: : ?
\= : ?
\:\= : ?

. : ?

+ : ?
- : ?
* : ?
/ : ?
% : ?
^ : ?
< : ?
> : ?
== : ?
<= : ?
>= : ?
!= : ?
& : ?
mut : ?
( : ?
) : ?
[ : ?
] : ?

string : logos
u8 : logos
u16 : logos
u32 : logos
u64 : logos
i8 : logos
i16 : logos
i32 : logos
i64 : logos
f32 : logos
f64 : logos
bool : logos         # a comparison's result logos; an if condition must be one
@void : logos
@exec : logos

callable := logos (          # the complete jump info — the ONE representation of jumpable code, never a bare address
    entry      : @exec
    convention : @synolon    # the declared calling-convention identity
)

if : ?
else : ?
for : ?
while : ?
and : ?
or : ?
xor : ?
not : ?


a := mut logos mut i32 32
a {
    hyle --m-> {
        hyle -> 32
    }
    logos --m-> {
        hyle -> {
            hyle -> copy i32.hyle
        }
        logos -> logos
    }
}

i32 {
    logos -> logos
    hyle -> [what ever fields for i32 is defined as]
}

mut {
    logos -> logos
    hyle -> [what ever fields for mut is defined as]
}

logos {
    logos -> logos
    hyle -> logos { # will not lay out all of logos's hyle in the same format for now
        precedence : f64
        associativity : u8
        constructor : fn (tape : parsing_tape) -> void!
        fields : logos
        destructor : ?
    }
}


logos {
  logos -> logos
  hyle -> {
    logos -> logos
    hyle -> {
      # member NAMES are id_context entries in the shared name index, not data
      # stored here (per-record names hashtable: rejected)
      fields -> {
        logos -> array
        hyle -> {
          element -> synolon
          size -> {logos -> u64, hyle -> ?}
          capacity -> {logos -> u64, hyle -> ?}
          data -> [
            {
              logos -> f64
              hyle -> ?
            }, {
              logos -> u8
              hyle -> ?
            }, {
              logos -> {
                logos -> fn
                hyle -> {
                  input -> logos (tape : parsing_tape)
                  output -> void!
                }
              }
              hyle -> ?
            }, {
              logos -> logos
              hyle -> ?
            }, {
              logos -> ?
              hyle -> ?
            }

          ]
        }
      }
      size_bytes -> {
        logos -> u64
        hyle -> ?
      }
    }
  }
}

a = a + 1
{
    logos:@synolon -> =
    hyle:@void -> {
        lhs:@synolon -> a
        rhs:@synolon -> {
            logos:@synolon -> +
            hyle:@void -> {
                lhs:@synolon -> a
                rhs:@synolon -> {
                    logos:@synolon -> rational_number
                    hyle:@void -> [num 1, den 1]     # a reduced fraction — never text
                }
                op:@synolon -> add_i32               # the resolved concrete operation (the conserved third slot)
            }
        }
        op:@synolon -> store_i32                     # the resolved store at the target's width
    }
}

# every operation below is one shape, three holes:
#     total := [start]
#     for i in [walk] ( total = [step] )
#     total
# the discrete tier walks in steps of 1; the calculus tier walks in steps of d.
# d is an infinitesimal: an actual number, greater than 0 and smaller than every
# machine-representable number. nothing containing d lowers to machine code (an
# operation over a sizeless logos does not lower until resolved): replace d with
# a small machine number (f64 1e-9) for approximation, or let the proof layer
# take d -> 0 for the exact value. every range is directed (start toward bound),
# the step signed with the direction of travel, which is what gives negative
# bounds the right sign.
d : ?
inf := 1 / d       # an actual infinite number: / below accepts an infinitesimal divisor
ninf := 0 - inf    # spelled as a value because - is always the binary operator
im : ?             # the imaginary unit, for the oscillating weights

# ---- the discrete tier: steps of 1 ----

# sum of f over a..b
sum := fn (f, a, b) -> ? (
    total := mut ? 0
    for i in a..b..1 (
        total = total + f(i)
    )
    total
)

# product of f over a..b
product := fn (f, a, b) -> ? (
    total := mut ? 1
    for i in a..b..1 (
        total = total * f(i)
    )
    total
)

# n! is the product of i itself
fact := fn (n) -> ? (
    total := mut ? 1
    for i in 1..n..1 (
        total = total * i
    )
    total
)

# a^n is the product of a constant
pow := fn (a, n) -> ? (
    total := mut ? 1
    for i in 1..n..1 (
        total = total * a
    )
    total
)

# ---- the calculus tier: steps of d ----

# multiplication is the sum of a in slices of d: a*d*(b/d) = a*b at any d.
# the a*d in the step is the primitive infinitesimal scaling this definition
# grounds in, not the * being defined
* := fn (a, b) -> ? (
    total := mut ? 0
    for i in 0..b..d (
        total = total + a*d
    )
    total
)

# division without dividing: walk 0..a in slices of b*d, count d per slice.
# the slice count is a/(b*d) and each slice counts d, so total = a/b with no /
# in the body. because d is an actual number this applies unchanged to
# infinitesimal divisors, which is what licenses inf := 1/d above and the
# derivative below
/ := fn (a, b) -> ? (
    total := mut ? 0
    for i in 0..a..(b*d) (
        total = total + d
    )
    total
)

# e^x is the product of (1 + d): (1 + d)^(x/d) -> e^x. e itself is exp(1)
exp := fn (x) -> ? (
    total := mut ? 1
    for i in 0..x..d (
        total = total * (1 + d)
    )
    total
)

# ln is the integral of 1/i, walked from 1
ln := fn (y) -> ? (
    total := mut ? 0
    for i in 1..y..d (
        total = total + d/i
    )
    total
)

# pi is the area of the unit circle
pi := (
    total := mut ? 0
    for i in -1..1..d (
        total = total + 2*(1 - i*i)^0.5*d
    )
    total
)

# the plain integral of f over a..b: the same loop as *, with f(i) varying
integral := fn (f, a, b) -> ? (
    total := mut ? 0
    for i in a..b..d (
        total = total + f(i)*d
    )
    total
)

# one integration level up: weight (b - i), Cauchy's formula. weight i is
# wrong for non-constant a: a(i) = i, b = 1 gives 1/3 where the true value
# is 1/6
*' := fn (a, b) -> ? (
    total := mut ? 0
    for i in 0..b..d (
        total = total + a*(b - i)*d
    )
    total
)

# the whole tower in one loop: n nested integrals of f over 0..b. n = 1 is
# integral, n = 2 is *'. with fact generalized to gamma, n need not be an
# integer: fractional calculus is this same line
integral_n := fn (f, b, n) -> ? (
    total := mut ? 0
    for i in 0..b..d (
        total = total + f(i)*pow(b - i, n - 1)/fact(n - 1)*d
    )
    total
)

# the derivative is division in loop form: walk the rise f(x+d) - f(x) in
# slices of d*d, count d per slice: (f(x+d) - f(x))/d. the result carries an
# infinitesimal tail (for x^2 it is 2x + d); exactness is d -> 0
/' := fn (f, x) -> ? (
    total := mut ? 0
    for i in 0..(f(x + d) - f(x))..(d*d) (
        total = total + d
    )
    total
)

# the second derivative: the rise of the rise, in slices of d*d*d
/'' := fn (f, x) -> ? (
    total := mut ? 0
    for i in 0..(f(x + d) - 2*f(x) + f(x - d))..(d*d*d) (
        total = total + d
    )
    total
)

# ---- one loop, many weights: the classical operations are the same walk
# with a weight dropped into the step ----

# expected value: the weight is a probability density
E := fn (f, p) -> ? (
    total := mut ? 0
    for i in ninf..inf..d (
        total = total + f(i)*p(i)*d
    )
    total
)

# fourier transform: the weight is an oscillation
fourier := fn (f, w) -> ? (
    total := mut ? 0
    for i in ninf..inf..d (
        total = total + f(i)*exp(0 - im*w*i)*d
    )
    total
)

# laplace transform: the weight is a decay
laplace := fn (f, s) -> ? (
    total := mut ? 0
    for i in 0..inf..d (
        total = total + f(i)*exp(0 - s*i)*d
    )
    total
)

# integration by substitution, the stieltjes integral: the weight is another
# function's rate. f * g' * x' written out
stieltjes := fn (f, g, a, b) -> ? (
    total := mut ? 0
    for i in a..b..d (
        total = total + f(g(i)) * /'(g, i) * d
    )
    total
)

# convolution: the weight is the other function, mirrored and shifted
convolve := fn (f, g, x) -> ? (
    total := mut ? 0
    for i in ninf..inf..d (
        total = total + f(i)*g(x - i)*d
    )
    total
)

# arc length of f over a..b: compose the derivative into the step
arclen := fn (f, a, b) -> ? (
    total := mut ? 0
    for i in a..b..d (
        total = total + (1 + /'(f, i)^2)^0.5*d
    )
    total
)
