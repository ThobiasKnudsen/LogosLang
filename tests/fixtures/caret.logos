# The v0.1.0 demo's operator, stressed (#63, DESIGN ›Execution is function
# application‹: "if the type carries a `code`, run that function on it"): a
# power operator `^` defined with `type` in Logos and used in the same file,
# right-associative, binding tighter than `*`, its constructor written in
# Logos and its instances' `run` slot holding the power computation, so the operator
# is the operation. `^` is a fresh symbol spelling (#110): nothing declared
# it before its `:=`, and once declared it lexes glued to its operands
# (`x^3`). `parse = (…)` is a bare body over the tape (#133 slice 5); `run`
# still wears the 4 September `fn` wrapper until its bare body runs (#133
# slice 8). The pinned demo itself is identities/power.logos.
^ := type (
    parse_rank = *.parse_rank + 1,
    associativity = right,
    parse = (
        tape[0]:dyad.type = ^,
        tape[0]:dyad.value.operands.append(tape[-1] and tape[1]),
        tape.remove(1),
        tape.remove(-1)
    ),
    instance = (
        shared run = fn (a := i32 ?, b := i32 ?) -> i32 (
            r := i32 1,
            for i in 0..b ( r = r * a ),
            r
        )
    )
),
f := fn (x := i32 ?) -> i32 ( x^3 + 1 ),
f.compile(),
f(2) + 2 ^ 3 ^ 2 + 2 * 3 ^ 2      # 9 + 512 + 18
