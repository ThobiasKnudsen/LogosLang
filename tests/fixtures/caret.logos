# The v0.1.0 demo's operator, stressed: a power operator `^` defined with
# `type` in Logos and used in the same file, right-associative, binding
# tighter than `*`, its parse and its instances' run both written in Logos,
# so the operator is the operation. `^` is a fresh symbol spelling: nothing
# declared it before its `:=`, and once declared it lexes glued to its
# operands (`x^3`). The pinned demo itself is identities/power.logos.
^ := type (
    instance = (
        lhs := ?,
        rhs := i32 ?,
        output := type ?,
        shared run = (
            mut r := this.output 1,
            for 0..this.rhs ( r = r * this.lhs ),
            r
        )
    ),
    parse_rank = *.parse_rank + 1,
    associativity = right,
    parse = (
        this.lhs = tape[-1],
        this.rhs = tape[1],
        this.output = tape[-1]:dyad.type,
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    )
),
f := fn (x := i32 ?) -> i32 ( x^3 + 1 ),
f.compile(),
f(2) + 2 ^ 3 ^ 2 + 2 * 3 ^ 2      # 9 + 512 + 18
