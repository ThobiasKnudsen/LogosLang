# A postfix operator defined in Logos and used in the same file: an
# appearance of `squared` runs its parse, written here, during the parse.
# The parse takes the cell to its left as the operand, `this.a = tape[-1]`,
# the fresh `squared` node filled by field name, placed with `tape[0] = this`
# and marked done by the parse itself; its parse_rank sits one above `*`'s,
# so `2 * x squared` squares first. Its run calls an ordinary function, `sq`,
# so a node of `squared` is the other shape a parse may build: an operation
# that is a call, its output the function's.
sq := fn (a := i32 ?) -> i32 ( a * a ),
squared := type (
    fields = ( a := i32 ?, output := type ?, shared run = ( sq(this.a) ) ),
    parse_rank = *.parse_rank + 1,
    associativity = left,
    parse = (
        this.a = tape[-1],
        this.output = i32,
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(-1)
    )
),
# A binary one: both cells, by name.
add := fn (a := i32 ?, b := i32 ?) -> i32 ( a + b ),
plus2 := type (
    fields = ( a := i32 ?, b := i32 ?, output := type ?, shared run = ( add(this.a, this.b) ) ),
    parse_rank = +.parse_rank,
    associativity = left,
    parse = (
        this.a = tape[-1],
        this.b = tape[1],
        this.output = i32,
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    )
),
x := i32 5,
f := fn (y := i32 ?) -> i32 ( y squared + 1 ),
sq.compile(), f.compile(),
x squared + f(3) + (3 plus2 4) + 2 * x squared    # 25 + 10 + 7 + 50
