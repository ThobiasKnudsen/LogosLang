# A postfix operator defined in Logos and used in the same file (issue #61;
# DESIGN ›The constructor is a field‹: an appearance of `squared` runs its
# constructor, written here, during the parse). Its constructor retypes its
# own cell into a call of `sq` and takes the cell to its left as the
# operand; its parse_rank sits one above `*`'s, so `2 * x squared` squares
# first. A `code` slot (#63) would make `squared` its own operation; this
# file keeps the other shape a constructor may build, a call of a function.
sq := fn (a := i32 ?) -> i32 ( a * a ),
squared := type (
    parse_rank = *.parse_rank + 1,
    associativity = left,
    constructor = fn (tape := parsing_tape ?) -> void (
        tape[0]:dyad.type = sq,
        tape[0]:dyad.value.operands.append(tape[-1]),
        tape.remove(-1)
    )
),
# A binary one: the and-group appends both operands.
add := fn (a := i32 ?, b := i32 ?) -> i32 ( a + b ),
plus2 := type (
    parse_rank = +.parse_rank,
    associativity = left,
    constructor = fn (tape := parsing_tape ?) -> void (
        tape[0]:dyad.type = add,
        tape[0]:dyad.value.operands.append(tape[-1] and tape[1]),
        tape.remove(1),
        tape.remove(-1)
    )
),
x := i32 5,
f := fn (y := i32 ?) -> i32 ( y squared + 1 ),
sq.compile(), f.compile(),
x squared + f(3) + (3 plus2 4) + 2 * x squared    # 25 + 10 + 7 + 50
