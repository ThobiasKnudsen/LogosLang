# A postfix operator defined in Logos and used in the same file (issue #61;
# DESIGN ›The constructor is a field‹: an appearance of `squared` runs its
# constructor, written here, during the parse). Its constructor takes the
# cell to its left as the operand — `this.a = tape[-1]`, the fresh `squared`
# node filled by field name, placed with `tape[0] = this` and marked done
# by the constructor itself (#133 slice 6) — and its parse_rank sits one
# above `*`'s, so `2 * x squared` squares first. Its `run` calls an ordinary
# function, `sq`, so a node of `squared` is the other shape a constructor
# may build: an operation that is a call.
sq := fn (a := i32 ?) -> i32 ( a * a ),
squared := type (
    instance = ( a := ?, shared run = fn (a := i32 ?) -> i32 ( sq(a) ) ),
    parse_rank = *.parse_rank + 1,
    associativity = left,
    parse = (
        this.a = tape[-1],
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(-1)
    )
),
# A binary one: both cells, by name.
add := fn (a := i32 ?, b := i32 ?) -> i32 ( a + b ),
plus2 := type (
    instance = ( a := ?, b := ?, shared run = fn (a := i32 ?, b := i32 ?) -> i32 ( add(a, b) ) ),
    parse_rank = +.parse_rank,
    associativity = left,
    parse = (
        this.a = tape[-1],
        this.b = tape[1],
        tape[0] = this,
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    )
),
x := i32 5,
f := fn (y := i32 ?) -> i32 ( y squared + 1 ),
sq.compile(), f.compile(),
x squared + f(3) + (3 plus2 4) + 2 * x squared    # 25 + 10 + 7 + 50
